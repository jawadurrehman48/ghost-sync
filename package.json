{
  "name": "ghost-sync",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:khata": "npm run dev --workspace=apps/khata",
    "dev:clinic": "npm run dev --workspace=apps/clinic-queue",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "tsc -p tests/tsconfig.json",
    "e2e": "node scripts/e2e-khata.mjs",
    "e2e:clinic": "node scripts/e2e-clinic.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@testing-library/react": "^16.3.3",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^3.22.0",
    "jsdom": "^31.0.0",
    "playwright-core": "1.65.0",
    "vitest": "^2.1.8"
  }
}
