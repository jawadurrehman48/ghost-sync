# Copy to .env.local (never commit .env.local) and fill in from Supabase:
# Project Settings -> Data API (project URL) and API Keys (publishable key).
# Leave empty to run local-only: the app works fully offline and the badge shows "Local only".
# Only the publishable key belongs here. Never put any other Supabase key in a frontend app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
